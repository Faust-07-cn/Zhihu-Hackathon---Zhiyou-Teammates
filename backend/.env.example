# 知乎开放平台 OAuth —— 不配置则自动进入 Mock 登录模式
# App ID 与 App Key 在知乎黑客松赛事页面获取
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# 回调地址需在知乎开放平台登记且完全一致；默认指向本地后端
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:8001/api/zhihu/callback

# 前端页面源（登录后重定向回哪个源；默认从请求 Origin/Referer 推导，仅手动访问时才用到）
FRONTEND_ORIGIN=http://localhost:8000

# 强制 Mock：即使已配置凭据也走假账号登录（便于演示）
ZHIHU_OAUTH_FORCE_MOCK=0

# 会话有效期（秒），默认 7 天
ZHIHU_OAUTH_SESSION_TTL=604800
